
/*
===============================================================================
Data Quality Checks: Silver Layer
===============================================================================

Script Purpose:
    This script performs comprehensive data quality checks on all six
    Silver Layer tables to validate data accuracy, consistency,
    completeness and standardization.

Checks Performed:
    1. Duplicate records.
    2. NULL and missing values.
    3. Unwanted spaces.
    4. Data standardization and consistency.
    5. Invalid dates and date ordering.
    6. Sales amount and quantity consistency.
    7. Referential integrity between CRM tables.
    8. ERP data quality and standardization.

Tables Checked:
    CRM:
        - crm_cust_info
        - crm_prd_info
        - crm_sales_details

    ERP:
        - erp_cust_az12
        - erp_loc_a101
        - erp_px_cat_g1v2

Expected Results:
    Queries designed to detect errors should return no records.
    DISTINCT queries display existing values for manual inspection.

===============================================================================
*/

-- Select the Silver database
USE silver;


/*
===============================================================================
1. CHECKING: silver.crm_cust_info
===============================================================================
*/


-- 1.1 Check for duplicate customer IDs
-- Expectation: No duplicate customer IDs

SELECT
    cst_id,
    COUNT(*) AS duplicate_count
FROM silver.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*) > 1;


-- 1.2 Check for NULL or zero customer IDs
-- Expectation: No NULL or zero customer IDs

SELECT *
FROM silver.crm_cust_info
WHERE cst_id IS NULL
   OR cst_id = 0;


-- 1.3 Check for unwanted spaces in customer names
-- Expectation: No results

SELECT *
FROM silver.crm_cust_info
WHERE cst_firstname <> TRIM(cst_firstname)
   OR cst_lastname <> TRIM(cst_lastname);


-- 1.4 Check for NULL customer names
-- Expectation: No missing first or last names

SELECT *
FROM silver.crm_cust_info
WHERE cst_firstname IS NULL
   OR cst_lastname IS NULL
   OR TRIM(cst_firstname) = ''
   OR TRIM(cst_lastname) = '';


-- 1.5 Check data standardization and consistency
-- Expectation: Only standardized marital status values

SELECT DISTINCT
    cst_marital_status
FROM silver.crm_cust_info;


-- 1.6 Check gender standardization
-- Expectation: FEMALE, MALE or N/A

SELECT DISTINCT
    cst_gndr
FROM silver.crm_cust_info;


-- 1.7 Check for missing customer creation dates

SELECT *
FROM silver.crm_cust_info
WHERE cst_create_date IS NULL;


/*
===============================================================================
2. CHECKING: silver.crm_prd_info
===============================================================================
*/


-- 2.1 Check for duplicate product IDs
-- Expectation: No duplicate product IDs

SELECT
    prd_id,
    COUNT(*) AS duplicate_count
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1;


-- 2.2 Check for NULL product IDs or product keys

SELECT *
FROM silver.crm_prd_info
WHERE prd_id IS NULL
   OR prd_key IS NULL
   OR TRIM(prd_key) = '';


-- 2.3 Check for unwanted spaces in product names
-- Expectation: No results

SELECT *
FROM silver.crm_prd_info
WHERE prd_nm <> TRIM(prd_nm);


-- 2.4 Check for NULL or negative product costs

SELECT *
FROM silver.crm_prd_info
WHERE prd_cost IS NULL
   OR prd_cost < 0;


-- 2.5 Check product line standardization
-- Expectation: Mountain, Road, Other sales, Touring or N/A

SELECT DISTINCT
    prd_line
FROM silver.crm_prd_info;


-- 2.6 Check for invalid date orders
-- Expectation: No results
-- Product end date should not be earlier than start date

SELECT *
FROM silver.crm_prd_info
WHERE prd_end_dt < prd_start_dt;


-- 2.7 Check for NULL product start dates

SELECT *
FROM silver.crm_prd_info
WHERE prd_start_dt IS NULL;


/*
===============================================================================
3. CHECKING: silver.crm_sales_details
===============================================================================
*/


-- 3.1 Check for NULL order numbers

SELECT *
FROM silver.crm_sales_details
WHERE sls_ord_num IS NULL
   OR TRIM(sls_ord_num) = '';


-- 3.2 Check for invalid or missing customer IDs

SELECT *
FROM silver.crm_sales_details
WHERE sls_cust_id IS NULL
   OR sls_cust_id = 0;


-- 3.3 Check for invalid or missing product keys

SELECT *
FROM silver.crm_sales_details
WHERE sls_prd_key IS NULL
   OR TRIM(sls_prd_key) = '';


-- 3.4 Check for invalid dates
-- Expectation: No results for missing dates, if all dates are required

SELECT *
FROM silver.crm_sales_details
WHERE sls_order_dt IS NULL
   OR sls_ship_dt IS NULL
   OR sls_due_dt IS NULL;


-- 3.5 Check for invalid date ordering
-- Order date should not be later than shipping or due date

SELECT *
FROM silver.crm_sales_details
WHERE sls_order_dt > sls_ship_dt
   OR sls_order_dt > sls_due_dt;


-- 3.6 Check for invalid sales values

SELECT *
FROM silver.crm_sales_details
WHERE sls_sales IS NULL
   OR sls_sales <= 0;


-- 3.7 Check for invalid quantities

SELECT *
FROM silver.crm_sales_details
WHERE sls_quantity IS NULL
   OR sls_quantity <= 0;


-- 3.8 Check for invalid selling prices

SELECT *
FROM silver.crm_sales_details
WHERE sls_price IS NULL
   OR sls_price <= 0;


-- 3.9 Check sales calculation consistency
-- Expected: Sales = Quantity * Price

SELECT *
FROM silver.crm_sales_details
WHERE sls_sales <> sls_quantity * ABS(sls_price);


-- 3.10 Check for sales records without matching customers
-- Expectation: No unmatched customer IDs

SELECT
    s.sls_cust_id
FROM silver.crm_sales_details s
LEFT JOIN silver.crm_cust_info c
    ON s.sls_cust_id = c.cst_id
WHERE c.cst_id IS NULL;


-- 3.11 Check for sales records without matching products
-- Expectation: No unmatched product keys

SELECT
    s.sls_prd_key
FROM silver.crm_sales_details s
LEFT JOIN silver.crm_prd_info p
    ON s.sls_prd_key = p.prd_key
WHERE p.prd_key IS NULL;


/*
===============================================================================
4. CHECKING: silver.erp_cust_az12
===============================================================================
*/


-- 4.1 Check for duplicate ERP customer IDs

SELECT
    cid,
    COUNT(*) AS duplicate_count
FROM silver.erp_cust_az12
GROUP BY cid
HAVING COUNT(*) > 1;


-- 4.2 Check for NULL customer IDs

SELECT *
FROM silver.erp_cust_az12
WHERE cid IS NULL
   OR TRIM(cid) = '';


-- 4.3 Check for unwanted spaces in customer IDs

SELECT *
FROM silver.erp_cust_az12
WHERE cid <> TRIM(cid);


-- 4.4 Check for future birth dates
-- Expectation: No future birth dates

SELECT *
FROM silver.erp_cust_az12
WHERE bdate > CURRENT_DATE();


-- 4.5 Check gender standardization
-- Expectation: Female, Male or n/a

SELECT DISTINCT
    gen
FROM silver.erp_cust_az12;


/*
===============================================================================
5. CHECKING: silver.erp_loc_a101
===============================================================================
*/


-- 5.1 Check for duplicate ERP location customer IDs

SELECT
    cid,
    COUNT(*) AS duplicate_count
FROM silver.erp_loc_a101
GROUP BY cid
HAVING COUNT(*) > 1;


-- 5.2 Check for NULL customer IDs

SELECT *
FROM silver.erp_loc_a101
WHERE cid IS NULL
   OR TRIM(cid) = '';


-- 5.3 Check for unwanted spaces in customer IDs

SELECT *
FROM silver.erp_loc_a101
WHERE cid <> TRIM(cid);


-- 5.4 Check country standardization
-- Review distinct country values

SELECT DISTINCT
    cntry
FROM silver.erp_loc_a101
ORDER BY cntry;


-- 5.5 Check for unwanted spaces in country names

SELECT *
FROM silver.erp_loc_a101
WHERE cntry <> TRIM(cntry);


/*
===============================================================================
6. CHECKING: silver.erp_px_cat_g1v2
===============================================================================
*/


-- 6.1 Check for duplicate product category IDs

SELECT
    id,
    COUNT(*) AS duplicate_count
FROM silver.erp_px_cat_g1v2
GROUP BY id
HAVING COUNT(*) > 1;


-- 6.2 Check for NULL product category IDs

SELECT *
FROM silver.erp_px_cat_g1v2
WHERE id IS NULL
   OR TRIM(id) = '';


-- 6.3 Check for unwanted spaces
-- Expectation: No results

SELECT *
FROM silver.erp_px_cat_g1v2
WHERE cat <> TRIM(cat)
   OR subcat <> TRIM(subcat)
   OR maintenance <> TRIM(maintenance);


-- 6.4 Check for NULL category information

SELECT *
FROM silver.erp_px_cat_g1v2
WHERE cat IS NULL
   OR subcat IS NULL;


-- 6.5 Check product category standardization

SELECT DISTINCT
    cat
FROM silver.erp_px_cat_g1v2
ORDER BY cat;


-- 6.6 Check product subcategory standardization

SELECT DISTINCT
    subcat
FROM silver.erp_px_cat_g1v2
ORDER BY subcat;


-- 6.7 Check maintenance value standardization

SELECT DISTINCT
    maintenance
FROM silver.erp_px_cat_g1v2;


/*
===============================================================================
END OF SILVER LAYER DATA QUALITY CHECKS
===============================================================================
*/
